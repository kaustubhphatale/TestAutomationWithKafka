{
  "name": "test-automation-with-kafka",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript automation framework for microservices and Kafka event-driven workflows",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:contract": "playwright test tests/contract",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:resilience": "playwright test tests/resilience",
    "test:ci": "playwright test --workers=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dotenv": "^16.4.7",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
